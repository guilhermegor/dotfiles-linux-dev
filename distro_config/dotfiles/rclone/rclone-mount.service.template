# systemd USER unit template for an on-demand rclone mount (issue #360).
#
# Not deployed by any install step directly — install_rclone_mount_unit()
# in distro_config/install_lib/sharing.sh substitutes {{REMOTE}} and
# {{MOUNTPOINT}} and writes the result to
# ~/.config/systemd/user/rclone-<remote>.service. That helper only WRITES
# the file; enable_rclone_mount_unit (`make rclone_mount`, #647) does
# daemon-reload + enable --now and verifies the mount.
#
# {{REMOTE}} must already exist in ~/.config/rclone/rclone.conf (via the
# interactive `rclone config` — never run by this repo's tooling).
# {{MOUNTPOINT}} must be an existing, empty directory that is not
# ~/Insync (mounting over a non-empty directory hides its contents).

[Unit]
Description=rclone on-demand mount: {{REMOTE}}
Documentation=man:rclone-mount(1)
After=network-online.target
Wants=network-online.target
AssertPathIsDirectory={{MOUNTPOINT}}
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
ExecStart=/usr/bin/rclone mount {{REMOTE}}: {{MOUNTPOINT}} \
    --vfs-cache-mode full \
    --vfs-cache-max-size 10G \
    --vfs-cache-max-age 24h
ExecStop=/bin/fusermount -u {{MOUNTPOINT}}
Restart=on-failure
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=default.target
