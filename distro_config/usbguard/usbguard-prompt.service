[Unit]
Description=USBGuard Allow/Block prompt (desktop dialog for blocked devices)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# --wait: retry until the daemon is up. The handler is the installed script.
ExecStart=/usr/bin/usbguard watch --wait --exec %h/.local/bin/usbguard-prompt
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
