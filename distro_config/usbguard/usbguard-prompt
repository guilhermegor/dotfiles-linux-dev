#!/bin/bash
#
# usbguard-prompt: Allow/Block desktop dialog for devices USBGuard blocked (#789).
#
# Runs in the user's graphical session as the handler of `usbguard watch -e`
# (see usbguard-prompt.service). The daemon is reached through the scoped IPC
# ACL (devices=modify,list,listen), so allow-device / block-device need no root;
# a PERMANENT allow rewrites the policy and goes through pkexec.
#
# The device name and serial in the rule are chosen by the device, so a
# Rubber Ducky controls them. They are never trusted: classification ignores
# every quoted string, and the name is sanitized before it reaches the dialog.
#
# Sourced by tests/usbguard_prompt.bats: main only runs when executed.

# The rule with every double-quoted string (and its \" escapes) emptied.
_usbguard_strip_quoted() {
    printf '%s' "$1" | sed -E 's/"([^"\\]|\\.)*"/""/g'
}

# Prints the class of a device from the `with-interface { ... }` part of its
# USBGuard rule: plain (no HID), hid (03:*), combo (08:* plus 03:*) or
# unknown (no interface info). Ambiguity fails toward the strongest warning:
# more than one with-interface block, or an empty one, is combo, never plain.
usbguard_classify() {
    local rule ifaces hid=0 storage=0 other=0 i
    rule="$(_usbguard_strip_quoted "$1")"
    local count
    count="$(printf '%s' "$rule" | grep -o 'with-interface' | wc -l)"
    if [ "$count" = 0 ]; then
        echo unknown
        return 0
    fi
    if [ "$count" != 1 ] || ! [[ "$rule" =~ with-interface[[:space:]]+(all-of|one-of|none-of|equals|equals-ordered)?[[:space:]]*\{([^}]*)\} ]]; then
        echo combo
        return 0
    fi
    ifaces="${BASH_REMATCH[2]}"
    [ -n "${ifaces//[[:space:]]/}" ] || { echo combo; return 0; }
    for i in $ifaces; do
        case "$i" in
            03:*) hid=1 ;;
            08:*) storage=1 ;;
            *) other=1 ;;
        esac
    done
    # plain is an allowlist: only when EVERY interface is mass storage.
    if [ "$hid" = 1 ] && [ "$storage" = 1 ]; then
        echo combo
    elif [ "$hid" = 1 ]; then
        echo hid
    elif [ "$other" = 1 ]; then
        echo other
    else
        echo plain
    fi
}

# Sanitized device name from the rule, or "unnamed device": control characters
# and backslashes dropped, capped at 64 characters.
usbguard_device_name() {
    local name=""
    if [[ "$1" =~ name[[:space:]]+\"(([^\"\\]|\\.)*)\" ]]; then
        # shellcheck disable=SC1003 # the trailing \\ is a tr escape for a backslash
        name="$(printf '%s' "${BASH_REMATCH[1]}" | tr -d '\000-\037\177\\')"
        name="${name:0:64}"
    fi
    if [ -n "$name" ]; then
        printf '%s' "$name"
    else
        printf 'unnamed device'
    fi
}

# Dialog body for CLASS (usbguard_classify output) and an already-sanitized
# NAME. Static text only goes through $'..'; the name goes through %s.
usbguard_prompt_text() {
    local class="$1" name="$2" nocheck msg
    nocheck=$'No check can prove a device is not a Rubber Ducky (a USB stick that types as a keyboard). Allow it only if you plugged it in on purpose.'
    case "$class" in
        combo) msg=$'!! STRONG WARNING !!\nThis device claims to be BOTH storage and a keyboard/HID, or its interfaces could not be read safely. That is the classic Rubber Ducky disguise.' ;;
        hid) msg=$'WARNING\nThis device claims to be a keyboard/HID. A keyboard can type commands into your session.' ;;
        other) msg=$'WARNING\nThis device is not plain storage: it claims a network, wireless, vendor-specific or other interface. Such a device can redirect your traffic or run firmware tricks.' ;;
        unknown) msg=$'WARNING\nThis device reports no interface information, so it cannot be classified. Treat it as a possible keyboard.' ;;
        *) msg=$'It looks like plain storage, but the device decides what it claims to be.' ;;
    esac
    printf '%s\n\nUSBGuard blocked a new USB device:\n  %s\n\n%s' "$msg" "$name" "$nocheck"
}

# Maps zenity's exit code and stdout to allow|always|block. Anything other than
# an explicit choice (close, timeout, error) keeps the device blocked.
usbguard_prompt_action() {
    local rc="$1" out="$2"
    if [ "$rc" = 0 ]; then
        echo allow
    elif [ "$out" = "Always allow" ]; then
        echo always
    else
        echo block
    fi
}

# Runs the usbguard command for ACTION on device ID.
usbguard_prompt_apply() {
    case "$1" in
        allow)  usbguard allow-device "$2" ;;
        always) pkexec usbguard allow-device -p "$2" ;;
        *)      usbguard block-device "$2" ;;
    esac
}

usbguard_prompt_dialog() {
    local id="$1" rule="$2" class out rc=0
    class="$(usbguard_classify "$rule")"
    # --default-cancel: Enter/Space on a focus-stealing dialog means Block.
    out="$(zenity --question --no-markup --default-cancel --timeout 120 \
        --title "USB device blocked ($class)" \
        --text "$(usbguard_prompt_text "$class" "$(usbguard_device_name "$rule")")" \
        --ok-label Allow --cancel-label Block --extra-button "Always allow")" || rc=$?
    usbguard_prompt_apply "$(usbguard_prompt_action "$rc" "$out")" "$id"
}

# Handler for `usbguard watch -e`: one call per IPC event, data in USBGUARD_*.
usbguard_prompt_main() {
    [ "${USBGUARD_DEVICE_EVENT:-}" = Insert ] || return 0
    [ "${USBGUARD_DEVICE_TARGET:-}" = block ] || return 0
    # Detached: the dialog must not hold up the next event.
    usbguard_prompt_dialog "$USBGUARD_DEVICE_ID" "${USBGUARD_DEVICE_RULE:-}" &
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    usbguard_prompt_main "$@"
fi
