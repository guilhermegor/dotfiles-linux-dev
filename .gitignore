# Created by https://www.toptal.com/developers/gitignore/api/dotenv,linux
# Edit at https://www.toptal.com/developers/gitignore?templates=dotenv,linux

### dotenv ###
.env

### Linux ###
*~

# temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# .nfs files are created when an open file is removed but is still being accessed
.nfs*

# End of https://www.toptal.com/developers/gitignore/api/dotenv,linux

# Caches left by the repo's Python hooks (ai_clients/claude/hooks/lib/*.py), run every
# session — untracked otherwise, and then flagged as uncommitted work (#541)
__pycache__/
*.py[cod]

# Git-ignored, GENERATED per-repo mirrors of the global lesson stores
# (~/.claude/memory/lessons*), regenerated by `make lessons_mirror` — never hand-edited.
# Local records only — the source of truth is the global store. Live under .specs/, not
# docs/: a mirror is a derived working artifact, not shipped documentation (dotfiles-dev#386;
# see .specs/CLAUDE.md). claude-toolchain-lessons.md is listed for parity with the other
# active repos' .gitignore — in THIS repo it is same-repo-skipped and never generated
# (dotfiles-dev#536: the store now declares dotfiles-dev/dotfiles-linux-dev/
# dotfiles-macos-dev/dotfiles-linux-prod as its own repo set).
.specs/_lessons/blueprintx-lessons.md
.specs/_lessons/claude-toolchain-lessons.md

# Claude Code project-local scratch: machine-local settings.local.json and the
# per-subagent worktrees the Agent tool creates. Never repo content (#196).
.claude/

# PR body scratch files staged for `gh pr create --body-file`
.git-pr-*.md
