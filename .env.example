# Template for the git-ignored .env at the repo root. `make run` (via
# distro_config/setup_env.sh) prompts to copy this file to .env; fill in the
# values there, never here. Keep .env at mode 600 — it holds credentials.

# --- Substituted into ~/.claude/ at deploy time by `make ai_clients` ---
# ai_clients/claude/lib/mcp_servers.sh reads these from $project_root/.env and
# replaces the KEY-GOES-HERE placeholders in the installed MCP server config.
CONTEXT7_API_KEY=KEY-GOES-HERE
TAVILY_API_KEY=KEY-GOES-HERE

# ai_clients/claude/lib/profiles.sh, same substitution, for the cheap-brain
# session profile (`claude-profile deepseek`).
DEEPSEEK_API_KEY=KEY-GOES-HERE

# --- Staged here, but consumed as a GitHub Actions secret ---
# .github/workflows/coderabbit_trigger.yml and review_retry.yml read this as
# ${{ secrets.GH_REVIEW_TRIGGER_PAT }}. GitHub Actions CANNOT read this file,
# so setting it here is only step one — it stages the value for:
#
#     gh secret set GH_REVIEW_TRIGGER_PAT --body "$GH_REVIEW_TRIGGER_PAT"
#
# run once per repository that has these workflows. Until that runs, no PR
# touching hooks/ or settings.json is reviewed (the workflow warns and skips).
#
# Mint it at github.com/settings/tokens as a fine-grained token:
# All repositories, Pull requests: Read and write. It must be a USER token —
# CodeRabbit silently ignores comments authored by GITHUB_TOKEN.
GH_REVIEW_TRIGGER_PAT=KEY-GOES-HERE

# --- Laptop battery charge cap: `make setup_battery` (drivers/battery_threshold.sh) ---
# Charging stops at END and resumes below START (0 <= START < END <= 100).
# Edit and re-run `make setup_battery` to change it — no code change needed;
# `make battery_full_charge` lifts the cap to 100% until setup_battery runs again.
# Omit START to use END-5. Ignored on desktops. An existing .env is never
# overwritten by setup_env, so add these two lines to it by hand.
BATTERY_START_THRESHOLD=75
BATTERY_END_THRESHOLD=80
