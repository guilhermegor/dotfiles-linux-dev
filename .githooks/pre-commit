#!/usr/bin/env bash
# Local pre-commit hook -- run the .specs/ and README structure gates
# locally, before push/CI, so a violation is caught at commit time instead
# of after a red CI round-trip (dotfiles-linux-dev#443: CI alone is one leg,
# and --no-verify bypasses it -- this is the other leg, the defect
# blueprintx#510 exists for; the README gate is dotfiles-linux-dev#828).
# Enable with `make git_hooks`.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bash "$REPO_ROOT/tests/check_specs_structure.sh"
bash "$REPO_ROOT/bin/check_readme_structure.sh" "$REPO_ROOT/README.md"
