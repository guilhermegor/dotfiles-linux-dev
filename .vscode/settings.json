{
  // =============================================
  // GENERAL EDITOR SETTINGS
  // =============================================
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "breadcrumbs.enabled": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.organizeFroms": "never"
  },
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.lineNumbers": "on",
  "files.eol": "\n",
  "workbench.editor.labelFormat": "short",
  "editor.glyphMargin": false,
  "workbench.activityBar.location": "bottom",
  "explorer.compactFolders": false,
  // =============================================
  // LANGUAGE-SPECIFIC SETTINGS
  // =============================================
  "[python]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.rulers": [
      99
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    },
    "workbench.colorCustomizations": {
      "editorRuler.foreground": "#D3D3D3"
    },
  },
  "[sql]": {
    "editor.rulers": [
      99
    ],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "workbench.colorCustomizations": {
      "editorRuler.foreground": "#D3D3D3"
    }
  },
  "[yaml]": {
    "editor.rulers": [
      99
    ],
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "workbench.colorCustomizations": {
      "editorRuler.foreground": "#D3D3D3"
    }
  },
  "yaml.format.singleQuote": true,
  "[toml]": {
    "editor.rulers": [
      99
    ],
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "workbench.colorCustomizations": {
      "editorRuler.foreground": "#D3D3D3"
    }
  },
  "[javascript]": {
    "editor.rulers": [
      120
    ],
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.rulers": [
      120
    ],
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescript]": {
    "editor.rulers": [
      120
    ],
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.rulers": [
      120
    ],
    "editor.tabSize": 2,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[html]": {
    "editor.rulers": [
      120
    ],
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[xml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[svg]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.rulers": [
      120
    ]
  },
  // =============================================
  // RUFF SPECIFIC SETTINGS
  // =============================================
  "ruff.lint.select": [
    "I"
  ],
  "ruff.organizeImports": true,
  // =============================================
  // FORMATTER CONFIGURATIONS
  // =============================================
  "prettier.useTabs": true,
  "prettier.singleQuote": true,
  "prettier.requirePragma": true,
  "prettier.insertPragma": true,
  // =============================================
  // WORKBENCH APPEARANCE
  // =============================================
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "OM Theme (Default Dracula Italic)",
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#D3D3D3"
  },
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  // Keep the secondary side bar collapsed in every new window/workspace
  // (toggle on demand with Ctrl+Alt+B). Without this, VS Code shows it by
  // default when opening a folder.
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  // =============================================
  // JUPYTER NOTEBOOK SETTINGS
  // =============================================
  "jupyter.useNotebookEditor": true,
  "jupyter.askForKernelRestart": false,
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  // =============================================
  // FILE HANDLING
  // =============================================
  "files.associations": {
    "*.ipynb": "jupyter",
    ".gitlint": "ini"
  },
  "files.exclude": {
    "**/.git": false,
    "**/.gitkeep": true,
    "**/.keep": true
  },
  "security.workspace.trust.untrustedFiles": "open",
  // =============================================
  // GIT SETTINGS
  // =============================================
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  // =============================================
  // TERMINAL SETTINGS
  // =============================================
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontSize": 14,
  // Nerd Font so statusLine / powerline / claude-hud icons render instead of
  // tofu. Installed by code_editors/vscode.sh; falls back to plain Cascadia and
  // Noto CJK so text + emoji still render if the Nerd Font is not yet present.
  "terminal.integrated.fontFamily": "'CaskaydiaCove Nerd Font Mono', 'Cascadia Code', 'Noto Sans Mono CJK SC', monospace",
  // Force the DOM renderer: the WebGL/canvas atlas drops the leading glyph of
  // bold/colored runs (e.g. "Wrote"->"rote"), corrupting Claude Code's TUI.
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.defaultColumns": 118,
  "terminal.integrated.defaultRows": 56,
  "workbench.panel.defaultLocation": "right",
  "workbench.panel.opensMaximized": "preserve"
}